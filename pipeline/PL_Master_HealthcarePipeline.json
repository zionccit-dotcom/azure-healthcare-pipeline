{
	"name": "PL_Master_HealthcarePipeline",
	"properties": {
		"activities": [
			{
				"name": "RunBronze",
				"type": "ExecutePipeline",
				"dependsOn": [],
				"policy": {
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"pipeline": {
						"referenceName": "CopyCovidDataToBronze",
						"type": "PipelineReference"
					},
					"waitOnCompletion": true
				}
			},
			{
				"name": "RunSilver",
				"type": "ExecutePipeline",
				"dependsOn": [
					{
						"activity": "RunBronze",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"pipeline": {
						"referenceName": "PL_Silver_TransformCovidData",
						"type": "PipelineReference"
					},
					"waitOnCompletion": true
				}
			},
			{
				"name": "RunGold",
				"type": "ExecutePipeline",
				"dependsOn": [
					{
						"activity": "RunSilver",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"pipeline": {
						"referenceName": "PL_Gold_LoadTopCountries",
						"type": "PipelineReference"
					},
					"waitOnCompletion": true
				}
			},
			{
				"name": "FailOnBronzeIngest",
				"description": "Failure path for RunBronze. Pairs with the Succeeded edge into RunSilver so the run is reported as failed rather than silently succeeding, and records why the downstream stages did not run.",
				"type": "Fail",
				"dependsOn": [
					{
						"activity": "RunBronze",
						"dependencyConditions": [
							"Failed"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"message": "@concat('Bronze ingest failed - Silver and Gold were skipped, so the gold table was not truncated or reloaded. Pipeline: ', pipeline().Pipeline, ' | Run ID: ', pipeline().RunId, ' | Trigger time: ', pipeline().TriggerTime)",
					"errorCode": "BronzeIngestFailed"
				}
			}
		],
		"annotations": [],
		"lastPublishTime": "2026-04-24T11:19:08Z"
	},
	"type": "Microsoft.DataFactory/factories/pipelines"
}